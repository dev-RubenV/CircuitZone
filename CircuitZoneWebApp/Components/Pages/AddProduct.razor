@page "/adicionar-produtos"
@rendermode InteractiveServer
@inject IWebApi WebApi
@inject ISnackbar Snackbar
@inject HttpClient Http
@inject NavigationManager NavigationManager
@using MudBlazor
@using CircuitZoneConsumerApi.Models
<title>Adicionar Produto</title>

<MudContainer MaxWidth="MaxWidth.ExtraLarge">
    <MudGrid Spacing="12">
        <MudItem>
            <MudPaper Elevation="2" Class="pa-4" Style="justify-content: center;">
                <MudText Class="mb-2" Typo="Typo.h6" Style="font-family: Lexend; font-weight:300;">Adicionar um novo produto</MudText>
                <EditForm Model="@productModel" OnValidSubmit="SaveProduct">
                    <MudStack Row Class="justify-space-between mud-width-full">
                        <MudStack Style="width: 800px">
                            <MudTextField OnlyValidateIfDirty="false" Label="Nome" Variant="Variant.Filled" Typo="Typo.subtitle1" @bind-Value="productModel.Nome" />
                            <MudTextField OnlyValidateIfDirty="false" Label="Descricao" Variant="Variant.Filled" Lines="10" @bind-Value="productModel.Descricao" />
                            <MudNumericField OnlyValidateIfDirty="false" HideSpinButtons="true" Label="Preco" Variant="Variant.Filled" @bind-Value="productModel.Preco" Min="0" />
                            <MudNumericField OnlyValidateIfDirty="false" Label="Quantidade Disponivel" Variant="Variant.Filled" @bind-Value="productModel.QuantidadeDisponivel" Min="0" />
                            <MudTextField OnlyValidateIfDirty="false" Label="Codigo EAN" Variant="Variant.Filled" @bind-Value="productModel.CodigoEAN" />

                            <MudSelect @bind-Value="productModel.MarcaId" Variant="Variant.Filled" Placeholder="Seleciona uma marca" Label="Marca">
                                @foreach (var marca in marcasModel)
                                {
                                    <MudSelectItem Value="marca.Id">@marca.NomeMarca</MudSelectItem>
                                }
                            </MudSelect>

                            <MudSelect @bind-Value="productModel.CategoriaId" Variant="Variant.Filled" Placeholder="Seleciona uma categoria" Label="Categoria">
                                @foreach (var categoria in categoriasModel)
                                {
                                    <MudSelectItem Value="categoria.Id">@categoria.CategoriaNome</MudSelectItem>
                                }
                            </MudSelect>
                            @if (productModel.ImagensUrls != null)
                            {
                                @foreach (var url in productModel.ImagensUrls.Select((value, index) => new { value, index }))
                                {
                                    var currentIndex = url.index;
                                    <MudTextField Label="Imagem URL" Variant="Variant.Filled" Clearable="true" Typo="Typo.subtitle1" @bind-Value="productModel.ImagensUrls[currentIndex]" />
                                }
                            }
                            <MudButton OnClick="AddImageUrl" Variant="Variant.Filled" Color="Color.Secondary">Adicionar Mais Imagens</MudButton>
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Adicionar Produto</MudButton>
                        </MudStack>
                    </MudStack>
                </EditForm>
            </MudPaper>

        </MudItem>
        <MudItem xs="6">
            <MudPaper Elevation="2" Class="pa-4 mb-12" Style="justify-content: center;">
                <MudText Class="mb-2" Typo="Typo.h6" Style="font-family: Lexend; font-weight:300;">Adicionar uma nova categoria</MudText>
                <EditForm Model="@saveCategoriasModel" OnValidSubmit="SaveCategoria">
                    <MudTextField OnlyValidateIfDirty="false" Class="mb-4" Label="Nome da Categoria" Variant="Variant.Filled" Typo="Typo.subtitle1" @bind-Value="saveCategoriasModel.CategoriaNome" />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Adicionar Categoria</MudButton>
                </EditForm>
            </MudPaper>
            <MudPaper Elevation="2" Class="pa-4" Style="justify-content: center;">
                <MudText Class="mb-2" Typo="Typo.h6" Style="font-family: Lexend; font-weight:300;">Adicionar uma nova marca</MudText>
                <EditForm Model="@saveMarcasModel" OnValidSubmit="SaveMarca">
                    <MudTextField OnlyValidateIfDirty="false" Class="mb-4" Label="Nome da Marca" Variant="Variant.Filled" Typo="Typo.subtitle1" @bind-Value="saveMarcasModel.NomeMarca" />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Adicionar Marca</MudButton>
                </EditForm>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>


@code {
    private ProductModel productModel = new ProductModel();
    private List<MarcasModel> marcasModel = new List<MarcasModel>();
    private List<CategoriasModel> categoriasModel = new List<CategoriasModel>();
    private CategoriasModel saveCategoriasModel = new CategoriasModel();
    private MarcasModel saveMarcasModel = new MarcasModel();

    protected override async Task OnInitializedAsync()
    {
        marcasModel = await WebApi.GetMarcas();
        categoriasModel = await WebApi.GetCategorias();
        productModel.MarcaId = marcasModel.FirstOrDefault().Id;
        productModel.CategoriaId = categoriasModel.FirstOrDefault().Id;
        if (productModel.ImagensUrls == null)
        {
            productModel.ImagensUrls = new List<string>();
        }
        StateHasChanged();
    }

    private async Task SaveProduct()
    {
        productModel.Id = 0;
        productModel.IsCreated = DateTime.Now;
        productModel.IsUpdated = DateTime.Now;
        productModel.IsDeleted = false;

        try
        {
            var result = await WebApi.AddProduto(productModel);
            Console.WriteLine($"API Response: {result}");
            Snackbar.Add($"Produto \"{productModel.Nome}\" adicionado com sucesso", Severity.Success);
            await Task.Delay(1000);
            NavigationManager.NavigateTo(NavigationManager.Uri, true);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro {ex.Message}", Severity.Error);
        }
    }

    private async Task SaveCategoria()
    {
        saveCategoriasModel.Id = 0;
        saveCategoriasModel.PrecoMedio = 0;
        saveCategoriasModel.ProdutoCount = 0;

        try
        {
            var result = await WebApi.AddCategoria(saveCategoriasModel);
            Snackbar.Add($"Categoria \"{saveCategoriasModel.CategoriaNome}\" adicionada com sucesso", Severity.Success);
            await Task.Delay(1000);
            NavigationManager.NavigateTo(NavigationManager.Uri, true);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro {ex.Message}", Severity.Error);
        }
    }

    private async Task SaveMarca()
    {
        saveMarcasModel.Id = 0;
        try
        {
            var result = await WebApi.AddMarca(saveMarcasModel);
            Snackbar.Add($"Marca \"{saveMarcasModel.NomeMarca}\" adicionada com sucesso", Severity.Success);
            await Task.Delay(1000);
            NavigationManager.NavigateTo(NavigationManager.Uri, true);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro {ex.Message}", Severity.Error);
        }
    }

    private void AddImageUrl()
    {
        if (productModel.ImagensUrls == null)
        {
            productModel.ImagensUrls = new List<string>();
        }
        productModel.ImagensUrls.Add(string.Empty);
    }
}
