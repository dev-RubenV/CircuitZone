@code {
    List<MovementsModel> Movimentos { get; set; } = new();

    protected override async Task OnParametersSetAsync()
    {
        Movimentos = await WebApi.GetMovimentos();
        _loading = false;
    }

    //MudTable
    private bool _loading = true;
}
