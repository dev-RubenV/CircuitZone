@page "/products"
@using CircuitZoneConsumerApi.Models;
@inject IWebApi WebApi
@inject NavigationManager NavigationManager

<h3>ProductList</h3>
@foreach (var product in ProductItems)
{
    <MudCard>
        <MudCardMedia Image="" Height="200"/>
        <MudCardContent>
            <MudText Typo="Typo.h5">@product.Nome</MudText>
            <MudText Typo="Typo.body1">@product.Preco</MudText>
            <MudText Typo="Typo.body2">@product.Descricao</MudText>
        </MudCardContent>
        <MudCardActions>
            <MudButton Variant="Variant.Text" Color="Color.Primary">Edit</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Error">Delete</MudButton>
        </MudCardActions>
    </MudCard>

}

@code {
    List<ProductModel> ProductItems { get; set; } = new();

    protected override async Task OnParametersSetAsync()
    {
        ProductItems = await WebApi.GetProduto();
    }
}
