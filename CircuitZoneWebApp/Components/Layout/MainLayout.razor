@inherits LayoutComponentBase

<MudThemeProvider/>
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Style="display: flex; flex-direction: column; height: 100vh;">
    <MudAppBar Elevation="0" Style="background-color: #212327; color: white;">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Style="color: #abb2bd;" Edge="Edge.Start" OnClick="@((e) => ToggleDrawer())" />
        <MudImage src="/Images/circuitzone_logo.svg"
                  style="height: 28px; width: auto; margin-left: 1rem;"
                  alt="CircuitZone Logo">
        </MudImage>
    </MudAppBar>
    <MudPaper Style="background-color: #292a2d; color: #f9f9f9; flex: 1; overflow: hidden; position: relative; padding-top: 64px;">
        <MudDrawerContainer Class="mud-height-full">
            <MudDrawer @bind-Open="@_open" Style="font-family: Lexend; background-color: #212327;" Fixed="false" Elevation="1" Variant="@DrawerVariant.Mini" OpenMiniOnHover="true">
                <MudNavMenu Class="custom-theme-active" Style="color:#abb2bd">
                    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
                    <MudNavLink Href="/products" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Store">Products</MudNavLink>
                    <MudNavLink Href="/addproduct" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.LibraryBooks">Add Product</MudNavLink>
                    <MudNavLink Href="/adduser" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Group">Add User</MudNavLink>
                </MudNavMenu>
            </MudDrawer>
            <MudMainContent>
                <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge">
                    @Body
                </MudContainer>
            </MudMainContent>
        </MudDrawerContainer>
    </MudPaper>
</MudLayout>


@code
{
    private bool _open = false;

    private void ToggleDrawer()
    {
        _open = !_open;
    }
}